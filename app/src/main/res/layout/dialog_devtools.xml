<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Section: User-Agent Switcher -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_ua_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_ua_desc"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgUserAgent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbUaAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_ua_auto"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbUaFirefox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_ua_firefox"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbUaFirefoxMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 Firefox Mobil"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbUaMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_ua_mobile"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbUaDesktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/devtools_ua_desktop"
                android:textSize="14sp" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyUa"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_ua_apply"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFirefoxAddons"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_open_firefox_addons"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="12dp" />

        <!-- Section: Öffnen mit & Aktionen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aktionen &amp; Externe Apps"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenWith"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_open_with"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstallXpi"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_install_xpi"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="12dp" />

        <!-- Section: JavaScript Console -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/devtools_console_title"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearConsole"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/devtools_console_clear"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceVariant">

            <TextView
                android:id="@+id/textConsoleLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:typeface="monospace"
                android:textSize="11sp"
                android:text="@string/devtools_no_logs" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/editJsCommand"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:hint="JavaScript Code eingeben..."
                android:textSize="13sp"
                android:typeface="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_address_bar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunJs"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/devtools_run_js"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textJsResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:typeface="monospace"
            android:textSize="11sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Section: Page Source & Details -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_source_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewHtmlSource"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/devtools_view_source"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textPageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:typeface="monospace"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
